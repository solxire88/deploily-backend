<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
    </mj-attributes>
    <mj-style inline="inline">
      .content .table { width: 100%; border-collapse: collapse; margin-top: 16px; }
      .content .table td { padding: 10px 12px; border: 1px solid #e5e7eb; font-size: 14px; color: #333; }
      .content .table td:first-child { background-color: #f9fafb; font-weight: bold; width: 40%; }
      .content .badge { display: inline-block; background-color: #dcfce7; color: #16a34a; padding: 4px 12px; border-radius: 999px; font-size: 13px; font-weight: bold; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#22c55e" padding="24px 0">
      <mj-column>
        <mj-text align="center" color="#ffffff" font-size="22px" font-weight="bold">
          {{ header_title|default("✅ Payment Completed") }}
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="24px" border-radius="0 0 8px 8px">
      <mj-column>
        <mj-text color="#444444" font-size="14px" line-height="1.6">
          <div class="content">{{ content|safe }}</div>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#f9fafb" padding="16px 24px">
      <mj-column>
        <mj-text align="center" color="#9ca3af" font-size="12px">
          This is an automated notification — please do not reply to this email.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
